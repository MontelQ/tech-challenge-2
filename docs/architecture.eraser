// Tech Challenge 2 — paste into a new Eraser Architecture Diagram.
// Solid arrows show image delivery, reconciliation, or HTTP traffic.
direction right
colorMode pastel
styleMode plain
typeface clean

Source [icon: github, label: "Private GitHub repository"]
Terraform [icon: terraform, label: "Terraform IaC"]
Actions [icon: github-actions, label: "GitHub Actions (gitops)"]
Visitor [icon: user, label: "Browser / reviewer"]

AWS [icon: aws-account, label: "AWS us-east-1 · account 394228349360"] {
  State [icon: aws-simple-storage-service, label: "S3 Terraform state"]
  ECR [icon: aws-elastic-container-registry, label: "ECR · tech-challenge-2"]

  VPC [icon: aws-vpc, label: "VPC · 10.20.0.0/16"] {
    Public [label: "Public subnets · 2 AZs"] {
      ALB [icon: aws-elb-application-load-balancer, label: "Internet-facing ALB · HTTP 80"]
      NAT [icon: aws-nat-gateway, label: "NAT gateway"]
    }
    Private [label: "Private subnets · 2 AZs"] {
      Jenkins [icon: jenkins, label: "Jenkins EC2 · SSM access"]
      Workers [icon: aws-auto-scaling-group, label: "Managed nodes · t3.small · min 1 / max 4"]
    }
  }

  EKS [icon: aws-elastic-kubernetes-service, label: "EKS · tech-challenge-2"] {
    Main [icon: helm, label: "tc2-app · Jenkins namespace · HPA 1–3"]
    GitOps [icon: helm, label: "tc2-gitops · GitOps namespace · HPA 1–3"]
    Argo [icon: kubernetes, label: "Argo CD · automated sync"]
    Autoscaler [icon: kubernetes, label: "Cluster Autoscaler"]
    Controller [icon: kubernetes, label: "AWS Load Balancer Controller"]
  }
}

Source > Jenkins: main branch / Jenkinsfile
Source > Actions: gitops branch / workflow
Source > Argo: gitops branch / Helm chart
Terraform > State: remote state
Terraform > VPC: provision
Terraform > EKS: provision
Jenkins > ECR: build and push commit image
Jenkins > Main: Helm upgrade / kubectl rollout
Actions > ECR: build and push SHA image
Actions > Source: commit SHA tag to values.yaml
Argo > GitOps: reconcile Helm release
ECR > Main: pull image
ECR > GitOps: pull image
Controller > ALB: reconcile Ingress
Visitor > ALB: GET / or /health
ALB > Main: route to Flask Service / Pods
Workers > Main: schedule Pods
Workers > GitOps: schedule Pods
Autoscaler > Workers: scale when needed
Private > NAT: outbound internet access
